{
  "expo": {
    "name": "Treino Comuna+",
    "slug": "treino-comuna-mais",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#111111",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "android": {
      "package": "br.com.treinocomunamais.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#8F1010"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Treino Comuna+ usa a câmera para registrar sua foto ao fim do treino.",
          "photosPermission": "O Treino Comuna+ acessa suas fotos somente quando você escolher uma imagem de progresso."
        }
      ]
    ]
  }
}
